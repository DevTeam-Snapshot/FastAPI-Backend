# 데이터베이스 관련
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=snapshot_app
DB_PASSWORD=!노션 확인!
DB_NAME=snapshot_test

# 모델
MODEL_GRPC_TARGET=127.0.0.1:50051
MODEL_TIMEOUT_SECONDS=120
PLANNING_MODEL_TIMEOUT_SECONDS=30
DRAFT_MODEL_TIMEOUT_SECONDS=180
MODEL_GRPC_MAX_MESSAGE_SIZE_MB=32

# 이미지
IMAGE_STORAGE_DIR=Image
IMAGE_URL_PREFIX=/images
KEEP_ORIGINAL_IMAGES=true
MAX_UPLOAD_IMAGE_SIZE_MB=25
MAX_UPLOAD_IMAGE_PIXELS=60000000
MAX_MODEL_IMAGE_PIXELS=20000000
DRAFT_IMAGE_WIDTH=1080
DRAFT_IMAGE_HEIGHT=1350